# Copie para `deploy/.env` no servidor e preencha. O `.env` nunca é versionado.

# Imagem construída no ovm-1 (Fase 2a) ou publicada em registry.
IMAGE=my-odk-client:latest

# Central de destino. A produção continua sendo o projeto 14; testes devem usar
# um projeto separado para não poluir a lista de entidades dos coletores.
CENTRAL_URL=https://odk.lucianovilasboas.com.br
CENTRAL_PROJECT_ID=14

# App User com escopo mínimo de leitura e envio. Nunca uma conta administrativa.
CENTRAL_APP_USER_TOKEN=
