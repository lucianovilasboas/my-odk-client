# Copie para `deploy/.env` no servidor e preencha. O `.env` nunca é versionado.

# Imagem construída no ovm-1 (Fase 2a) ou publicada em registry.
IMAGE=my-odk-client:latest

# Chave que cifra o cookie de sessão (AES-GCM). 32 bytes aleatórios em base64.
#   openssl rand -base64 32
# Rotacionar invalida todas as sessões: cada aparelho precisa ler o QR de novo.
SESSION_SECRET=

# OPCIONAL. Sem ALLOWED_CENTRAL_HOSTS o adaptador aceita qualquer Central https
# público vindo do QR — loopback, rede privada e endpoints de metadata são
# recusados pela validação de DNS/IP (ADR 0004). Preencha só para restringir.
# ALLOWED_CENTRAL_HOSTS=odk.lucianovilasboas.com.br

# OPCIONAL. O projeto vem do QR do App User, como no Collect. Deixe vazio para
# aceitar qualquer projeto do host; preencha só para restringir.
# ALLOWED_PROJECT_IDS=

# NÃO existe token de App User aqui, por decisão (ADR 0003): cada agente
# configura o seu pelo QR, e o token vive apenas dentro do cookie cifrado.
